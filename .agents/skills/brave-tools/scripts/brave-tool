#!/usr/bin/env bash
# .agents/skills/brave-tools/brave-tool
# A bash wrapper to execute Brave browser tasks using ts-node.

# Determine the directory of the script
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Ensure the browser is running with remote debugging enabled
"$DIR/ensure-browser"

# Ensure global dependencies are installed
"$DIR/ensure-deps"

# Set NODE_PATH to the global npm root so ts-node can find global packages
export NODE_PATH="$(npm root -g)"

# Set ts-node to transpile only for performance
export TS_NODE_TRANSPILE_ONLY=1

# Execute the TypeScript script
npx ts-node "$DIR/browser.ts" "$@"
